# ---------------------------------------------------------------------------
# Envoy — frontend environment
# Copy to .env and fill in. Only VITE_* vars reach the browser.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Map tiles (Thunderforest) — optional, the map falls back to CartoDB
VITE_THUNDERFOREST_KEY=

# NOTE: there is no VITE_API_BASE any more. The Express backend is gone;
# every call goes through Supabase. Server-side secrets (RESEND_API_KEY,
# SUPABASE_SERVICE_ROLE_KEY, …) belong to the Edge Function only — set them
# with `supabase secrets set`, never here.
